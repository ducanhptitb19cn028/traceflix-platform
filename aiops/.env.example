# TraceFlix-AIOps webui — live Streaming page configuration (template).
# Copy to `.env` (same directory) and adjust. Loaded by webui/backend/app.py at
# startup via python-dotenv, so the Streaming page runs live with no command-line
# env. Comment a line out to fall back to the in-process bus / heuristic LLM.

# Kafka event backbone (real broker). Unset/empty -> in-memory bus.
TF_KAFKA_BOOTSTRAP=localhost:9092

# Local-LLM detector via Ollama. Unreachable -> heuristic fallback.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: parallel Ollama calls during offline LLM eval (streaming path is serial).
# LLM_CONCURRENCY=4
