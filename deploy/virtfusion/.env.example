# ─────────────────────────────────────────────────────────────────────────────
# TraceFlix on VirtFusion — shared deployment variables
# Copy to `.env` on EACH VM and fill in. Values must be identical across all VMs
# (except WG_SELF_* which is per-host). Nothing here touches the upstream project.
# ─────────────────────────────────────────────────────────────────────────────

# --- WireGuard private mesh (fixed IPs; see README §3) ---------------------------
WG_SUBNET=10.10.0.0/24
VM1_GPU_IP=10.10.0.1        # GPU node  — AIOps engine + dashboard backend
VM2_SVC_IP=10.10.0.2        # normal    — TraceFlix microservices + load-gen + otel-collector
VM3_TEL_IP=10.10.0.3        # normal    — Prometheus / VictoriaMetrics / Loki / Tempo
VM4_GW_IP=10.10.0.4         # normal    — Grafana + nginx public gateway (TLS)

# --- Image tags (pinned to what the upstream manifests use) ----------------------
MOVIE_IMAGE=traceflix/movie-service:1.0.0
ACTOR_IMAGE=traceflix/actor-service:1.0.0
REVIEW_IMAGE=traceflix/review-service:1.0.0
# mesh-expansion services (each its own module under services/, sharing mesh-core)
GATEWAY_IMAGE=traceflix/gateway-service:1.0.0
USER_IMAGE=traceflix/user-service:1.0.0
SEARCH_IMAGE=traceflix/search-service:1.0.0
RECOMMENDATION_IMAGE=traceflix/recommendation-service:1.0.0
AUTH_IMAGE=traceflix/auth-service:1.0.0
CATALOG_IMAGE=traceflix/catalog-service:1.0.0
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.110.0
PROM_IMAGE=prom/prometheus:v2.54.1
VM_IMAGE=victoriametrics/victoria-metrics:v1.103.0
LOKI_IMAGE=grafana/loki:2.9.8
TEMPO_IMAGE=grafana/tempo:2.5.0
GRAFANA_IMAGE=grafana/grafana:11.1.4

# --- Secrets (CHANGE THESE) ------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please
# htpasswd hash for the public dashboard (see README §8). Default below = admin/admin.
DASHBOARD_BASIC_AUTH=admin:$apr1$8Hpd0fGm$Q7rqY2xQ0z0a0Z9oTf0Hd1

# --- Public hostname for TLS (point DNS A-record at VM4's public IP) --------------
PUBLIC_HOST=traceflix.example.com
ACME_EMAIL=you@example.com
