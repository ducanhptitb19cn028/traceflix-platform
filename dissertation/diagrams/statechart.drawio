<mxfile host="app.diagrams.net">
  <diagram name="State chart (fault + detection)" id="st">
    <mxGraphModel dx="1000" dy="720" grid="0" pageWidth="900" pageHeight="560" math="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="ini" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="20" height="20" as="geometry"/></mxCell>

        <mxCell id="norm" value="Normal&#10;p99 &lt; SLO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="140" y="100" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="deg" value="Degrading&#10;(fault ramp α↑)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="warn" value="Early-Warning&#10;(detector alarms before breach)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="280" width="190" height="60" as="geometry"/></mxCell>
        <mxCell id="brch" value="Breached&#10;p99 ≥ SLO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="det" value="Detected&#10;(alarm at / after breach)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="160" height="60" as="geometry"/></mxCell>
        <mxCell id="fin" value="" style="ellipse;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="600" y="440" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="finr" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="604" y="444" width="14" height="14" as="geometry"/></mxCell>

        <mxCell style="endArrow=block;html=1;" edge="1" parent="1" source="ini" target="norm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="fault injected" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="norm" target="deg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="detector flags developing fault&#10;[lead &gt; 0; earlier with traces]" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="deg" target="warn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="p99 ≥ SLO" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="deg" target="brch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="warning &#8594; breach&#10;(measured lead-time)" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="warn" target="brch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="classifier flags window" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="brch" target="det"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="remediation / fault cleared" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="det" target="norm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="310"/><mxPoint x="210" y="200"/></Array></mxGeometry></mxCell>
        <mxCell value="episode ends" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="det" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
