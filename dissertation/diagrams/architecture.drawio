        <mxCell id="laneO" value="RQ-O  Cost-Optimisation" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#e6f6ec;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="380" width="290" height="200" as="geometry"/></mxCell>
