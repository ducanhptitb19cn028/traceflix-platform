        <mxCell id="dr4" value="lead-time per configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9d9;" vertex="1" parent="1"><mxGeometry x="36" y="500" width="258" height="34" as="geometry"/></mxCell>

        <mxCell id="laneA" value="RQ-A  Robustness" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#fff4e6;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="290" height="200" as="geometry"/></mxCell>
        <mxCell id="ar1" value="degradation operator&#10;sampling &#183; noise &#183; modality dropout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="346" y="412" width="258" height="46" as="geometry"/></mxCell>
        <mxCell id="ar2" value="RandomForest detector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="346" y="466" width="258" height="32" as="geometry"/></mxCell>
