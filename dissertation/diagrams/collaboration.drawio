<mxfile host="app.diagrams.net">
  <diagram name="Collaboration (RQ-O run)" id="col">
    <mxGraphModel dx="1000" dy="760" grid="0" pageWidth="940" pageHeight="600" math="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="res" value=":Researcher" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="40" height="80" as="geometry"/></mxCell>
        <mxCell id="opt" value=":OptimiseExperiment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f6ec;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="230" y="260" width="170" height="50" as="geometry"/></mxCell>
        <mxCell id="gen" value=":TelemetryGenerator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="fb" value=":FeatureBuilder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="510" y="160" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="mdl" value=":BaselineModel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="met" value=":Metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="140" height="50" as="geometry"/></mxCell>
        <mxCell id="par" value=":ParetoAnalyzer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="270" width="150" height="50" as="geometry"/></mxCell>

        <mxCell value="1: run(configs)" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="res" target="opt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="2: generate_run(config, sampling) *" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="opt" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="3: build_features(signals) *" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="opt" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="4: fit / predict *" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="opt" target="mdl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="5: compute(f1) *" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="opt" target="met"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="6: _cost(config, sampling) *" style="endArrow=open;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="opt" target="met"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="350" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell value="7: pareto({f1, cost})" style="endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="opt" target="par"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell value="8: front + knee" style="endArrow=open;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="par" target="opt"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell value="* = repeated over 20 configs (modality × sampling)" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="230" y="470" width="360" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
