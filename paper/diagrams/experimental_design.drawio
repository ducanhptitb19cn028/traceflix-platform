        <mxCell id="r0" value="R0&#10;(warm-up)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="110" height="44" as="geometry" /></mxCell>
