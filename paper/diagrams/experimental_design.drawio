        <mxCell id="er01" style="rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er12" style="rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="er23" style="rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>

