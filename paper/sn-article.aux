\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A taxonomy of cloud-native anomaly detection along six dimensions---four of \emph  {design} (D1--D4) and two of \emph  {evaluation} (D5--D6). Shaded leaves mark the region the present study occupies: it holds the detection model fixed (D2) as a control while sweeping telemetry completeness (D1) and the learning paradigm (D3) \emph  {together}, evaluating detection and localisation under controlled drift (D5--D6). The bulk of prior work fixes D3 to static-batch and D5 to stationary.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:taxonomy}{{1}{8}{A taxonomy of cloud-native anomaly detection along six dimensions---four of \emph {design} (D1--D4) and two of \emph {evaluation} (D5--D6). Shaded leaves mark the region the present study occupies: it holds the detection model fixed (D2) as a control while sweeping telemetry completeness (D1) and the learning paradigm (D3) \emph {together}, evaluating detection and localisation under controlled drift (D5--D6). The bulk of prior work fixes D3 to static-batch and D5 to stationary}{figure.1}{}}
