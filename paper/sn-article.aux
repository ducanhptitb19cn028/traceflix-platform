\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The TraceFlix testbed and detection pipeline. A load generator drives the instrumented nine-service mesh (full call graph in Fig.~\ref {fig:mesh}); Chaos Mesh (or Pumba, on the Compose deployment) injects timestamped faults. OpenTelemetry collects MELT telemetry into per-pillar backends, whose signals flow over an \emph  {Apache Kafka} event backbone (Fig.~\ref {fig:dataflow}) to a configuration-aware feature extractor (C1--C4) feeding the three learning policies, a local-LLM detector (Qwen2.5-3B; Fig.~\ref {fig:llm}), and the evaluation harness.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:arch}{{3}{13}{The TraceFlix testbed and detection pipeline. A load generator drives the instrumented nine-service mesh (full call graph in Fig.~\ref {fig:mesh}); Chaos Mesh (or Pumba, on the Compose deployment) injects timestamped faults. OpenTelemetry collects MELT telemetry into per-pillar backends, whose signals flow over an \emph {Apache Kafka} event backbone (Fig.~\ref {fig:dataflow}) to a configuration-aware feature extractor (C1--C4) feeding the three learning policies, a local-LLM detector (Qwen2.5-3B; Fig.~\ref {fig:llm}), and the evaluation harness}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{The local-LLM detector (Fig.~\ref {fig:llm}).}{13}{section*.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The nine-service call graph (depth four). \texttt  {gateway} is the entry; blue nodes are internal callers, green nodes are leaves. \texttt  {catalog} is a shared \emph  {fan-in} reached by both \texttt  {search} and \texttt  {recommendation}. Data owners (\texttt  {catalog}, \texttt  {auth}, \texttt  {user}) persist with Spring Data JPA; the rest orchestrate downstream calls. A fault at a leaf induces secondary latency in every ancestor on its path---the propagation RQ2 exploits.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:mesh}{{4}{14}{The nine-service call graph (depth four). \texttt {gateway} is the entry; blue nodes are internal callers, green nodes are leaves. \texttt {catalog} is a shared \emph {fan-in} reached by both \texttt {search} and \texttt {recommendation}. Data owners (\texttt {catalog}, \texttt {auth}, \texttt {user}) persist with Spring Data JPA; the rest orchestrate downstream calls. A fault at a leaf induces secondary latency in every ancestor on its path---the propagation RQ2 exploits}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The Kafka streaming dataflow. Per-window telemetry is produced to \texttt  {tf.telemetry.windows}; the online ML detector and the local-LLM detector consume it in independent consumer groups and emit binary verdicts to \texttt  {tf.anomalies}, tagged by detector for head-to-head comparison.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:dataflow}{{5}{14}{The Kafka streaming dataflow. Per-window telemetry is produced to \texttt {tf.telemetry.windows}; the online ML detector and the local-LLM detector consume it in independent consumer groups and emit binary verdicts to \texttt {tf.anomalies}, tagged by detector for head-to-head comparison}{figure.5}{}}
\citation{pedroso2025}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The local-LLM detector pipeline. A window's raw signals are formatted into a prompt (fault-signature rules {+} few-shot exemplars); Qwen2.5-3B, served by Ollama and optionally LoRA-tuned, returns a strict JSON binary verdict that is parsed to the same $0/1$ output as the other detectors. When no model is served the pipeline falls back to a clearly-marked z-score heuristic (dashed), never silently substituted for the model.}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:llm}{{6}{15}{The local-LLM detector pipeline. A window's raw signals are formatted into a prompt (fault-signature rules {+} few-shot exemplars); Qwen2.5-3B, served by Ollama and optionally LoRA-tuned, returns a strict JSON binary verdict that is parsed to the same $0/1$ output as the other detectors. When no model is served the pipeline falls back to a clearly-marked z-score heuristic (dashed), never silently substituted for the model}{figure.6}{}}
