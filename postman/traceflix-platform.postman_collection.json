{
  "info": {
    "name": "TraceFlix Platform",
    "_postman_id": "traceflix-platform-0001",
    "description": "API tests for the TraceFlix microservices platform (Spring Boot, com.vinsguru).\n\nAll services expose port 8080 internally. For local testing, port-forward / map each service to a distinct host port and set the matching `*Url` collection variable.\n\nSuggested defaults:\n- gatewayUrl        -> http://localhost:8080\n- movieUrl          -> http://localhost:8081\n- actorUrl          -> http://localhost:8082\n- reviewUrl         -> http://localhost:8083\n- catalogUrl        -> http://localhost:8084\n- searchUrl         -> http://localhost:8085\n- authUrl           -> http://localhost:8086\n- userUrl           -> http://localhost:8087\n- recommendationUrl -> http://localhost:8088\n\nSeed accounts (auth-service data.sql): id 1 alice/PREMIUM/tok-alice, 2 bob/STANDARD/tok-bob, 3 carol/PREMIUM/tok-carol, 4 dave/BASIC/tok-dave, 5 erin/STANDARD/tok-erin.\n\nIf running everything behind a single gateway/port, just point every `*Url` variable at the same base URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "movieUrl", "value": "http://localhost:8081" },
    { "key": "actorUrl", "value": "http://localhost:8082" },
    { "key": "reviewUrl", "value": "http://localhost:8083" },
    { "key": "catalogUrl", "value": "http://localhost:8084" },
    { "key": "searchUrl", "value": "http://localhost:8085" },
    { "key": "authUrl", "value": "http://localhost:8086" },
    { "key": "userUrl", "value": "http://localhost:8087" },
    { "key": "recommendationUrl", "value": "http://localhost:8088" },
    { "key": "userId", "value": "1" },
    { "key": "movieId", "value": "1" },
    { "key": "actorId", "value": "1" },
    { "key": "catalogId", "value": "1" },
    { "key": "token", "value": "tok-alice" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level smoke tests applied to every request.",
          "pm.test('status is 2xx or expected 404', function () {",
          "    pm.expect([200, 404]).to.include(pm.response.code);",
          "});",
          "pm.test('responds within 5s', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Gateway",
      "item": [
        {
          "name": "Browse home page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/browse?userId={{userId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "browse"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "Aggregated home page for a user (user profile+recs, trending, featured)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('has userId', () => pm.expect(b).to.have.property('userId'));",
                  "pm.test('carries aggregated sections', () => {",
                  "    pm.expect(b).to.have.property('user');",
                  "    pm.expect(b).to.have.property('trending');",
                  "    pm.expect(b).to.have.property('featured');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Validate token (valid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/validate?token={{token}}",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "validate"],
              "query": [{ "key": "token", "value": "{{token}}" }]
            },
            "description": "Validate an auth token. Seed token 'tok-alice' -> alice/PREMIUM."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('valid is true', () => pm.expect(b.valid).to.be.true);",
                  "pm.test('has username and role', () => {",
                  "    pm.expect(b.username).to.be.a('string').and.not.empty;",
                  "    pm.expect(b.role).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate token (invalid)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/validate?token=not-a-real-token",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "validate"],
              "query": [{ "key": "token", "value": "not-a-real-token" }]
            },
            "description": "An unknown token returns valid=false with null username/role."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('valid is false', () => pm.expect(b.valid).to.be.false);",
                  "pm.test('username is null', () => pm.expect(b.username).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/{{userId}}",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "{{userId}}"]
            },
            "description": "Fetch account (id, username, role). 404 when not found."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('id matches request', () => pm.expect(String(b.id)).to.eql(pm.variables.get('userId')));",
                  "pm.test('has username and role', () => {",
                  "    pm.expect(b.username).to.be.a('string');",
                  "    pm.expect(b.role).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get account by id (not found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/api/auth/999999",
              "host": ["{{authUrl}}"],
              "path": ["api", "auth", "999999"]
            },
            "description": "Unknown user id returns 404."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
